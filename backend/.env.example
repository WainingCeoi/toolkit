# Copy to backend/.env; every setting is optional and a set value overrides the default.

# --- API server ---
# Comma-separated CORS origins for the Vite dev frontend (default: the value below).
#APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Built frontend served as static files by make start/host (default ../frontend/dist).
#APP_STATIC_DIR=../frontend/dist

# --- Which tools to enable ---
# Comma- or space-separated tool slugs to disable; default none. A disabled tool is
# hidden and its routers are never mounted, the public /sub route included.
#TOOLKIT_DISABLED_TOOLS=doc-to-markdown

# --- LAN hosting (`make host`) ---
# HOST and PORT are read from the shell/Make environment, not from this file.
# HOST: bind address (default 0.0.0.0 = on the LAN; 127.0.0.1 = this machine only).
# PORT: base port (default 8000); the launcher auto-advances past a busy one.
# SECURITY: 0.0.0.0 exposes the app (no auth; moves/deletes files) to the whole Wi-Fi.

# --- Magnet Scraper (Automatic mode) ---
# Base URL of the site to walk (no default; Automatic mode needs it).
#WEBSITE_URL=https://example.com
# "Last watched" video URL that stops the walk; auto-advanced after each run.
#CUTOFF_VIDEO=https://example.com/last-watched-video

# --- Watermark Remover ---
# Device the LaMa inpainter runs on: cpu, mps or cuda (default: best available).
#WATERMARK_DEVICE=cpu
# Pre-downloaded big-lama.pt checkpoint (default: fetched on first use, ~200 MB).
#WATERMARK_LAMA_MODEL=

# --- Optimized-IP Subscription ---
# SQLite database path; blank or unset means backend/data/sub.db. It also anchors
# the other runtime data (torrents.db, the watermark workspace).
#SUB_DB_PATH=
# Require ?token=… on subscription links (default: no token).
#SUB_ACCESS_TOKEN=
# Host used in subscription links; defaults to this Mac's .local name, then a LAN IP.
#SUB_PUBLIC_HOST=
