# Whole-repo only — sub-project rules live in backend/.gitignore and frontend/.gitignore.

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Agent scratch
.claude/

# Legacy Streamlit-era root .env (backend/.env is the live config)
/.env

# Runtime databases land here when SUB_DB_PATH is unset -- running the app any
# way other than through main.py (a script, a test) falls back to the repo root
# instead of backend/data/, and those files are never ours to commit.
/data/
